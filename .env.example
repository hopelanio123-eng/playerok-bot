# =============================================================================
# Настройки. Скопируй этот файл в .env и заполни.
# =============================================================================

# --- Обязательно ------------------------------------------------------------

# Токен бота от @BotFather
BOT_TOKEN=

# Куки авторизованной сессии playerok.com
# (DevTools -> Application -> Cookies -> значение "cookie" целиком)
PLAYEROK_COOKIE=

# Id чата, куда бот шлёт алерты (например -1001234567890)
NOTIFICATION_GROUP_ID=

# Твои Telegram id через запятую - доступ к командам /mode /settings /ai
CONTROL_ALLOWED_USERS=


# --- Рынки (цены) -----------------------------------------------------------

# Токены API gift-satellite.dev через запятую, каждый с префиксом "Token "
GIFT_SATELLITE_TOKENS=

# Общий адрес API (обычно менять не нужно)
GIFT_SATELLITE_API_URL=https://gift-satellite.dev/api


# --- ИИ: порядок провайдеров ------------------------------------------------
# Кто первый, того и пробуем. Если у провайдера кончилась квота (429),
# бот автоматически переходит к следующему.
AI_PROVIDERS=gemini,openrouter,nvidia,cloudflare,pollinations,groq

# Ключи Google AI Studio через запятую (бесплатная квота)
GEMINI_KEYS=
# Отдельный ключ для запросов с заголовком paid: true
GEMINI_PAID_KEY=
# Модель и адрес локального прокси
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_SERVER=http://127.0.0.1:9322

# OpenRouter - бесплатные модели с картинкой (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_TEXT_MODEL=thinkingmachines/inkling-small:free

# NVIDIA NIM - бесплатные кредиты (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Cloudflare Workers AI - 10000 нейронок в сутки бесплатно
# (https://dash.cloudflare.com : Account ID + API Token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct

# Pollinations - бесплатный ключ (https://enter.pollinations.ai/key)
POLLINATIONS_API_KEY=
POLLINATIONS_VISION_MODEL=openai/gpt-4o-mini
POLLINATIONS_TEXT_MODEL=openai/gpt-4o-mini

# Groq - только текстовые модели (для торга)
GROQ_API_KEYS=
GROQ_TEXT_MODEL=openai/gpt-oss-120b


# --- Прочее ------------------------------------------------------------------

# Минимальный интервал между запросами к PlayerOK, сек
PLAYEROK_MIN_INTERVAL=1.2
PLAYEROK_MAX_RETRIES=4

# Порт контроллера (управление режимами)
CONTROL_PORT=9324
